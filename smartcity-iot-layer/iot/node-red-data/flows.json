    {
        "id": "mqtt-crowd-in",
        "type": "mqtt in",
        "z": "tab-crowd",
        "name": "city/+/crowd",
        "topic": "city/+/crowd",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker-city",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 80,
        "wires": [
            [
                "fn-crowd-transform"
            ]
        ]
    },
    {
        "id": "fn-crowd-transform",
        "type": "function",
        "z": "tab-crowd",
        "name": "Transform Crowd Payload",
        "func": "const [, zone] = msg.topic.split('/');\nconst payload = typeof msg.payload === 'object' ? msg.payload : JSON.parse(msg.payload);\nmsg.payload = {\n    zone,\n    density_count: Number(payload.density_count),\n    risk_level: payload.risk_level,\n    speed: Number(payload.speed),\n    timestamp: payload.timestamp,\n    event_type: payload.event_type || null,\n    test_run_id: payload.test_run_id || null,\n    source_topic: msg.topic\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 80,
        "wires": [
            [
                "http-crowd-post"
            ]
        ]
    },
    {
        "id": "http-crowd-post",
        "type": "http request",
        "z": "tab-crowd",
        "name": "POST /iot/crowd",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://api:3000/iot/crowd",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": true,
        "headers": [
            {
                "keyType": "str",
                "keyValue": "Content-Type",
                "valueType": "str",
                "valueValue": "application/json"
            }
        ],
        "x": 630,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "catch-crowd",
        "type": "catch",
