        "uncaught": false,
        "x": 150,
        "y": 150,
        "wires": [
            [
                "fn-crowd-queue"
            ]
        ]
    },
    {
        "id": "fn-crowd-queue",
        "type": "function",
        "z": "tab-crowd",
        "name": "Queue Failed Crowd",
        "func": "msg.payload = JSON.stringify({\n    queued_at: new Date().toISOString(),\n    flow: 'crowd',\n    error: msg.error && msg.error.message,\n    payload: msg.payload\n}) + '\\n';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
