{
  "info": {
    "name": "Smart Crowd Control Platform",
    "_postman_id": "smart-crowd-control-v1",
    "description": "Koleksi lengkap API endpoint Smart Crowd Control Platform.\n\n## Setup\n1. Import collection ini ke Postman\n2. Set environment variable:\n   - `baseUrl` = `http://localhost:3000`\n   - `oauthUrl` = `http://localhost:3002`\n3. Jalankan request **[AUTH] Login Citizen** dulu — token otomatis tersimpan\n\n## Urutan test yang disarankan\n1. AUTH → Login Citizen\n2. CROWD → Get Current\n3. CROWD → Submit Reading\n4. ML → Predict Crowd\n5. ANOMALY → Detect",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3000", "type": "string" },
    { "key": "oauthUrl",  "value": "http://localhost:3002", "type": "string" },
    { "key": "token",     "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "reportId",  "value": "1", "type": "string" },
    { "key": "incidentId","value": "1", "type": "string" },
    { "key": "citizenId", "value": "1", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 AUTH — OAuth 2.0",
      "item": [
        {
          "name": "Login Citizen (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.refresh_token || '');",
                  "  console.log('✅ Token tersimpan:', json.access_token.substring(0,30) + '...');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ada access_token', () => pm.expect(json).to.have.property('access_token'));",
                  "pm.test('Ada token_type Bearer', () => pm.expect(json.token_type).to.eql('Bearer'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{oauthUrl}}/oauth/token", "host": ["{{oauthUrl}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "username",   "value": "officer@smartcity.id" },
                { "key": "password",   "value": "password123" },
                { "key": "client_id",  "value": "citizen_app" },
                { "key": "client_secret", "value": "citizen_secret" }
              ]
            }
          }
        },
        {
          "name": "Client Credentials (IoT/Service-to-Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ada access_token', () => pm.expect(json).to.have.property('access_token'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{oauthUrl}}/oauth/token", "host": ["{{oauthUrl}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "client_credentials" },
                { "key": "client_id",     "value": "iot_device" },
                { "key": "client_secret", "value": "iot_secret" }
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  console.log('✅ Token diperbarui');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{oauthUrl}}/oauth/token", "host": ["{{oauthUrl}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "refresh_token" },
                { "key": "refresh_token", "value": "{{refreshToken}}" },
                { "key": "client_id",     "value": "citizen_app" },
                { "key": "client_secret", "value": "citizen_secret" }
              ]
            }
          }
        },
        {
          "name": "Introspect Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token aktif', () => pm.expect(json.active).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{oauthUrl}}/oauth/introspect", "host": ["{{oauthUrl}}"], "path": ["oauth","introspect"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "token",         "value": "{{token}}" },
                { "key": "client_id",     "value": "citizen_app" },
                { "key": "client_secret", "value": "citizen_secret" }
              ]
            }
          }
        },
        {
          "name": "Revoke Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{oauthUrl}}/oauth/revoke", "host": ["{{oauthUrl}}"], "path": ["oauth","revoke"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "token",         "value": "{{token}}" },
                { "key": "client_id",     "value": "citizen_app" },
                { "key": "client_secret", "value": "citizen_secret" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "🏥 GATEWAY — Health & Metrics",
      "item": [
        {
          "name": "Health Check (Semua Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 atau 207', () => {",
                  "  pm.expect([200, 207]).to.include(pm.response.code);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Gateway up', () => pm.expect(json.gateway).to.eql('up'));",
                  "pm.test('Ada list services', () => pm.expect(json.services).to.be.an('array'));",
                  "pm.test('Response < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "",
                  "// Tampilkan status tiap service di console",
                  "json.services.forEach(s => {",
                  "  const icon = s.status === 'up' ? '✅' : '❌';",
                  "  console.log(`${icon} ${s.name}: ${s.status} (${s.latency_ms}ms)`);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Prometheus Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type text/plain', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
          }
        },
        {
          "name": "Rate Limit Test (Burst 10 req)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ada header RateLimit-Remaining', () => {",
                  "  pm.expect(pm.response.headers.has('RateLimit-Remaining') ||",
                  "             pm.response.headers.has('X-RateLimit-Remaining')).to.be.true;",
                  "});",
                  "const remaining = pm.response.headers.get('RateLimit-Remaining') ||",
                  "                  pm.response.headers.get('X-RateLimit-Remaining');",
                  "console.log('Sisa request:', remaining);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "404 — Route Tidak Ada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const json = pm.response.json();",
                  "pm.test('Format standar: status error', () => pm.expect(json.status).to.eql('error'));",
                  "pm.test('Format standar: ada service field', () => pm.expect(json.service).to.eql('api-gateway'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/route-tidak-ada", "host": ["{{baseUrl}}"], "path": ["route-tidak-ada"] }
          }
        },
        {
          "name": "401 — Akses Tanpa Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test('Ada pesan error', () => pm.expect(json.message).to.be.a('string'));",
                  "pm.test('Service = api-gateway', () => pm.expect(json.service).to.eql('api-gateway'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/crowd/current", "host": ["{{baseUrl}}"], "path": ["api","crowd","current"] }
          }
        }
      ]
    },

