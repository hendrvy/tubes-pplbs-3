# ─── Gateway ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_secret_panjang_dan_acak

# ─── OAuth Server ───────────────────────────────────────────
OAUTH_SERVER_URL=http://localhost:3002

# ─── Upstream Services ──────────────────────────────────────
CROWD_SERVICE_URL=http://localhost:8000
INCIDENT_SERVICE_URL=http://localhost:8001
ENV_SERVICE_URL=http://localhost:8002
PYTHON_ML_URL=http://localhost:5000

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=3600000
AUTH_RATE_LIMIT_MAX=500
